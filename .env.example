# Yoke Ad Studio -- set these in Vercel (Project → Settings → Environment Variables). Never commit values.
NEXT_PUBLIC_SUPABASE_URL=https://uevktzprbpymfcquotmb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # Supabase → Project Settings → API → anon / publishable key
SUPABASE_SERVICE_ROLE_KEY=            # same page, service_role / secret key. Server only.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=yokegtm.com

# Optional -- each switches on one feature. Leave empty until Shane approves the service.
ANTHROPIC_API_KEY=                    # Claude replies in Create an ad (Anthropic API, billed separately)
ANTHROPIC_MODEL=claude-sonnet-5-5
SLACK_BOT_TOKEN=                      # Share to Slack via a Yoke Slack app (xoxb-...); without it, sharing copies a message
